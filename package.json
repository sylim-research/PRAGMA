{
  "name": "pragma",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "start": "serve -s dist",
    "hsk3:build": "node scripts/build-hsk3-reference.mjs",
    "hsk3:audit": "node scripts/audit-hsk3-reference.mjs",
    "prompts:snapshot": "node scripts/snapshot-prompts.mjs",
    "edge:deploy": "node scripts/deploy-edge-function.mjs",
    "prompts:verify": "node scripts/verify-deterministic-snapshots.mjs",
    "pack:attest": "node scripts/register-pack-manifest-attestation.mjs",
    "rls:smoke": "node scripts/rls-role-smoke.mjs",
    "backup:list": "vite-node scripts/course-backup.ts list",
    "backup:export": "vite-node scripts/course-backup.ts export",
    "backup:verify": "vite-node scripts/course-backup.ts verify",
    "content:batch": "vite-node scripts/run-lock-content-batch.ts",
    "review:bundle": "node scripts/build-content-review-domain.mjs",
    "review:db-test": "node --test scripts/content-review-db.test.mjs",
    "release:policy-test": "node --test scripts/verify-production-source.test.mjs",
    "release:lineage": "node scripts/verify-main-lineage.mjs",
    "prebuild": "node scripts/verify-production-source.mjs && node scripts/snapshot-prompts.mjs && node scripts/build-content-review-domain.mjs --check",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:moat": "vitest run src/lib/pragma/realizationPack.test.ts src/lib/pragma/packReleaseManifest.test.ts src/lib/pragma/seedGoldSet.test.ts src/lib/pragma/goldCalibration.test.ts src/lib/pragma/goldExpertReview.test.ts src/lib/pragma/goldRegression.test.ts src/lib/pragma/missionLineage.test.ts src/lib/pragma/itemLineage.test.ts src/lib/pragma/expertReviewConsensus.test.ts src/lib/pragma/expertReviewProtocol.test.ts src/lib/pragma/moatFlywheel.test.ts src/lib/pragma/moatMigrationContracts.test.ts src/lib/pragma/researchQaSummary.test.ts src/lib/pragma/finalCorpusGeneration.test.ts src/lib/mission/missionEventExport.test.ts src/lib/mission/missionRelease.test.ts src/lib/pragma/targetFeatures.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.14",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.14",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-query": "^5.83.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.462.0",
    "next-themes": "^0.3.0",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "serve": "^14.2.6",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9.32.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.32.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "jsdom": "^20.0.3",
    "playwright": "^1.61.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
