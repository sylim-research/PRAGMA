# =============================================================================
# Frontend (Vite) — 값을 채워 사용. 실제 키는 커밋 금지.
# 이 세 값은 Supabase/Lovable Cloud 연결 시 자동 주입됩니다.
# =============================================================================
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# 시연용 둘러보기 진입("임시 학습자로 시작하기").
# 개발 환경(npm run dev)에서는 항상 켜져 있고, 배포 환경에서는 이 값을 "true"로
# 둔 경우에만 노출된다. 학습자 여정은 전부 mock 데이터라 실데이터가 노출되지
# 않으며, 관리자 화면은 실제 로그인 + admin 권한을 요구하므로 영향을 받지 않는다.
# 실증(9월) 시작 전에는 반드시 제거하거나 false 로 둘 것.
VITE_ENABLE_DEMO=
# 디펜스 대표 미션. 비우면 운영 2주차의 고정 대표 미션을 사용한다.
VITE_DEMO_MISSION_ID=

# =============================================================================
# Edge Function secrets (Supabase secrets에만 저장).
# ※ 아래 값들은 절대 프론트 .env 에 넣지 말 것.
#    Supabase Dashboard → Edge Functions → Secrets 로만 관리.
# =============================================================================
# OPENAI_API_KEY=            # generate-scenario: OpenAI Chat Completions
# ELEVENLABS_API_KEY=        # tts: 음성 합성 (사용 시)
# 보이스는 ttsVoicePolicy.ts의 한국어·중국어 디자인 목소리로 고정합니다.
# ELEVENLABS_API_KEY 권한: Text to Speech, User 읽기(관리자 잔량 점검).
# SUPADATA_API_KEY=          # youtube-transcript: YouTube 자막 추출
# SUPABASE_SERVICE_ROLE_KEY= # Edge Function 서버측 DB 접근 (RLS 우회)
